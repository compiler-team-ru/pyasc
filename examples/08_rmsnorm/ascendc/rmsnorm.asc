#include "acl/acl.h"
#include "basic_api/kernel_operator.h"
#include "highlevel_api/lib/normalization/rmsnorm.h"
#include "highlevel_api/kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

static int64_t CeilDiv(int64_t a, int64_t b) { return (a + b - 1) / b; }

static int64_t ParseArg(int argc, char** argv, const char* name, int64_t defaultValue)
{
    for (int i = 1; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], name) == 0) {
            return std::atoll(argv[i + 1]);
        }
    }
    return defaultValue;
}

static float ParseFloatArg(int argc, char** argv, const char* name, float defaultValue)
{
    for (int i = 1; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], name) == 0) {
            return std::atof(argv[i + 1]);
        }
    }
    return defaultValue;
}

static bool NeedCheck(int argc, char** argv)
{
    for (int i = 1; i < argc; ++i) {
        if (std::strcmp(argv[i], "--check") == 0) {
            return true;
        }
    }
    return false;
}

static int64_t PickCoreCount(int64_t neededCores, int64_t maxCoreNum)
{
    int64_t candidate = 1;
    while (candidate <= maxCoreNum) {
        if (neededCores <= candidate) {
            return candidate;
        }
        candidate *= 2;
    }
    return maxCoreNum;
}

static int64_t GetAivCoreNum()
{
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return 8;
    }
    uint32_t coreNum = platform->GetCoreNumAiv();
    return coreNum == 0 ? 8 : static_cast<int64_t>(coreNum);
}

static void CheckAcl(aclError ret, const char* what)
{
    if (ret != ACL_SUCCESS) {
        std::printf("[ERROR] %s failed, ret=%d\n", what, static_cast<int>(ret));
        std::exit(1);
    }
}

static int64_t MaxRowsPerCall(int64_t hiddenSize)
{
    if (hiddenSize <= 512) return 8;
    if (hiddenSize <= 1024) return 4;
    return 2;
}


extern "C" __global__ __vector__ void rms_norm_kernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR rms, GM_ADDR gamma,
    int64_t totalRows, int64_t blockFactor,
    int64_t hiddenSize, int64_t maxRowsPerCall,
    float eps, float invH, int64_t rowsPerCoreParam)
{
    int64_t coreIdx = AscendC::GetBlockIdx();
    int64_t blockOffset = coreIdx * blockFactor;
    int64_t remaining = totalRows - blockOffset;
    if (remaining <= 0) {
        return;
    }
    int64_t rowsPerCore = (remaining > blockFactor) ? blockFactor : remaining;
    int64_t bufElems = maxRowsPerCall * hiddenSize;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQue;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> gammaBuf;
    AscendC::GlobalTensor<float> xGm, yGm, rmsGm, gammaGm;
    xGm.SetGlobalBuffer((__gm__ float*)x + blockOffset * hiddenSize, rowsPerCore * hiddenSize);
    yGm.SetGlobalBuffer((__gm__ float*)y + blockOffset * hiddenSize, rowsPerCore * hiddenSize);
    rmsGm.SetGlobalBuffer((__gm__ float*)rms + coreIdx * rowsPerCoreParam, rowsPerCoreParam);
    gammaGm.SetGlobalBuffer((__gm__ float*)gamma, hiddenSize);

    pipe.InitBuffer(inQue, 2, bufElems * sizeof(float));
    pipe.InitBuffer(outQue, 2, bufElems * sizeof(float));
    pipe.InitBuffer(gammaBuf, hiddenSize * sizeof(float));

    AscendC::LocalTensor<float> gammaLocal = gammaBuf.Get<float>();
    AscendC::DataCopy(gammaLocal, gammaGm, hiddenSize);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

    int64_t loopCount = (rowsPerCore + maxRowsPerCall - 1) / maxRowsPerCall;
    for (int64_t i = 0; i < loopCount; i++) {
        int64_t rowsThisCall = (i == loopCount - 1) ? (rowsPerCore - i * maxRowsPerCall) : maxRowsPerCall;
        int64_t nElems = rowsThisCall * hiddenSize;
        int64_t gmOffset = i * maxRowsPerCall * hiddenSize;
        AscendC::LocalTensor<float> xLocal = inQue.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm[gmOffset], nElems);
        inQue.EnQue(xLocal);
        xLocal = inQue.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = outQue.AllocTensor<float>();

        AscendC::tiling::RmsNormTiling tiling;
        tiling.bLength = 1;
        tiling.sLength = rowsThisCall;
        tiling.hLength = hiddenSize;
        tiling.originalHLength = hiddenSize;
        tiling.reciprocalOfHLength = invH;
        tiling.mainBshLength = nElems;
        tiling.mainBsLength = rowsThisCall;
        tiling.mainBsLengthAlign = ((rowsThisCall + 15) / 16) * 16;
        tiling.loopRound = 1;
        tiling.inputTailPos = nElems;
        tiling.tailBshLength = 0;
        tiling.tailBsLength = 0;
        AscendC::RmsNorm<float, true>(yLocal, xLocal, gammaLocal, eps, tiling);

        inQue.FreeTensor(xLocal);
        outQue.EnQue(yLocal);
        yLocal = outQue.DeQue<float>();
        AscendC::DataCopy(yGm[gmOffset], yLocal, nElems);
        outQue.FreeTensor(yLocal);
    }

    // Per-row rms = x[0] * gamma[0] / (y[0] + eps)
    AscendC::TBuf<AscendC::QuePosition::VECCALC> rmsBuf;
    pipe.InitBuffer(rmsBuf, rowsPerCore * sizeof(float) + 16);
    AscendC::LocalTensor<float> rmsLocal = rmsBuf.Get<float>();
    float g0 = gammaGm.GetValue(0);
    for (int64_t row = 0; row < rowsPerCore; row++) {
        AscendC::LocalTensor<float> xtmp = rmsBuf.Get<float>();
        AscendC::DataCopy(xtmp, xGm[row * hiddenSize], 1);
        float x0 = xtmp.GetValue(0);
        AscendC::LocalTensor<float> ytmp = rmsBuf.Get<float>();
        AscendC::DataCopy(ytmp, yGm[row * hiddenSize], 1);
        float y0 = ytmp.GetValue(0);
        rmsLocal.SetValue(row, x0 * g0 / (y0 + eps));
    }
    AscendC::DataCopy(rmsGm, rmsLocal, rowsPerCore);
}

int32_t main(int32_t argc, char** argv)
{
    int64_t batch = ParseArg(argc, argv, "--batch", 2);
    int64_t seq = ParseArg(argc, argv, "--seq", 64);
    int64_t hidden = ParseArg(argc, argv, "--hidden", 256);
    int64_t warmup = ParseArg(argc, argv, "--warmup", 5);
    int64_t iters = ParseArg(argc, argv, "--iters", 20);
    float eps = ParseFloatArg(argc, argv, "--eps", 1e-6f);
    int64_t totalRows = batch * seq;
    int64_t totalElements = totalRows * hidden;
    int64_t useCoreNum = GetAivCoreNum();
    int64_t maxRowsPerCall = MaxRowsPerCall(hidden);
    int64_t effectiveCores = totalRows < useCoreNum ? std::max<int64_t>(totalRows, 1) : useCoreNum;
    int64_t blockFactor = CeilDiv(totalRows, effectiveCores);
    int64_t rowsPerCore = CeilDiv(totalRows, effectiveCores);
    float invH = 1.0f / static_cast<float>(hidden);
    size_t xBytes = totalElements * sizeof(float);
    size_t gammaBytes = hidden * sizeof(float);
    size_t rmsBytes = effectiveCores * rowsPerCore * sizeof(float);

    CheckAcl(aclInit(nullptr), "aclInit");
    CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");
    aclrtStream stream = nullptr;
    CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

    std::vector<float> xHost(totalElements), gammaHost(hidden, 1.0f), yHost(totalElements);
    std::vector<float> rmsHost(effectiveCores * rowsPerCore, 0.0f);
    for (int64_t i = 0; i < totalElements; ++i) {
        xHost[i] = static_cast<float>((i % 257) - 128) / 64.0f;
    }

    void *xDev = nullptr, *gammaDev = nullptr, *yDev = nullptr, *rmsDev = nullptr;
    CheckAcl(aclrtMalloc(&xDev, xBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x");
    CheckAcl(aclrtMalloc(&gammaDev, gammaBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc gamma");
    CheckAcl(aclrtMalloc(&yDev, xBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc y");
    CheckAcl(aclrtMalloc(&rmsDev, rmsBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc rms");
    CheckAcl(aclrtMemcpy(xDev, xBytes, xHost.data(), xBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy x");
    CheckAcl(aclrtMemcpy(gammaDev, gammaBytes, gammaHost.data(), gammaBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy gamma");

    for (int64_t i = 0; i < warmup + iters; ++i) {
        rms_norm_kernel<<<effectiveCores, nullptr, stream>>>(
            static_cast<uint8_t*>(xDev), static_cast<uint8_t*>(yDev), static_cast<uint8_t*>(rmsDev),
            static_cast<uint8_t*>(gammaDev),
            totalRows, blockFactor, hidden, maxRowsPerCall, eps, invH, rowsPerCore);
    }
    CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");

    if (NeedCheck(argc, argv)) {
        CheckAcl(aclrtMemcpy(yHost.data(), xBytes, yDev, xBytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy y");
        float maxErr = 0.0f;
        for (int64_t row = 0; row < totalRows; ++row) {
            float sum = 0.0f;
            for (int64_t h = 0; h < hidden; ++h) {
                float v = xHost[row * hidden + h];
                sum += v * v;
            }
            float scale = 1.0f / std::sqrt(sum / static_cast<float>(hidden) + eps);
            for (int64_t h = 0; h < hidden; ++h) {
                int64_t idx = row * hidden + h;
                float ref = xHost[idx] * scale * gammaHost[h];
                maxErr = std::max(maxErr, std::fabs(yHost[idx] - ref));
            }
        }
        if (maxErr > 1e-3f) {
            std::printf("FAIL max_err=%f\n", maxErr);
            return 1;
        }
    }

    aclrtFree(xDev);
    aclrtFree(gammaDev);
    aclrtFree(yDev);
    aclrtFree(rmsDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    std::printf("DONE op=rmsnorm backend=ascendc shape=(%ld,%ld,%ld) warmup=%ld iters=%ld\n",
                batch, seq, hidden, warmup, iters);
    return 0;
}
