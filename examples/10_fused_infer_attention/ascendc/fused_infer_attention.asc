#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

// Return ceil(a / b). Both arguments must be positive.
// Inputs: dividend a and positive divisor b.
// Returns: integer ceiling quotient.
static int64_t CeilDiv(int64_t a, int64_t b)
{
    return (a + b - 1) / b;
}

// Read one integer option from argv, or return dflt when it is absent.
// Inputs: argc/argv, option name, and fallback value.
// Returns: parsed integer or dflt.
static int64_t ParseArg(int argc, char** argv, const char* name, int64_t dflt)
{
    for (int i = 1; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], name) == 0) {
            return std::atoll(argv[i + 1]);
        }
    }
    return dflt;
}

// Return whether the demo should compare device output with the CPU reference.
// Inputs: process argc/argv.
// Returns: true when --check is present.
static bool NeedCheck(int argc, char** argv)
{
    for (int i = 1; i < argc; ++i) {
        if (std::strcmp(argv[i], "--check") == 0) {
            return true;
        }
    }
    return false;
}

// Report one ACL failure and let the caller unwind already-created resources.
// Inputs: ACL status and operation label.
// Returns: true on ACL_SUCCESS, otherwise false after printing the failure.
static bool CheckAcl(aclError ret, const char* w)
{
    if (ret != ACL_SUCCESS) {
        std::printf("[ERROR] %s ret=%d\n", w, static_cast<int>(ret));
        return false;
    }
    return true;
}

// Convert between half and its storage bits without violating aliasing rules.
// Inputs: one float16 value.
// Returns: its uint16 storage representation.
static uint16_t HalfToBits(half value)
{
    uint16_t bits = 0;
    std::memcpy(&bits, &value, sizeof(bits));
    return bits;
}

// Reconstruct one half value from its alias-safe storage representation.
// Inputs: uint16 float16 storage bits.
// Returns: reconstructed float16 value.
static half BitsToHalf(uint16_t bits)
{
    half value = 0;
    std::memcpy(&value, &bits, sizeof(value));
    return value;
}

// A 512-column tile provides enough Cube work while keeping AIV UB usage valid.
constexpr int64_t KV_TILE = 512;
// SoftmaxFlashV2 processes eight score rows per call in this implementation.
constexpr int64_t SOFTMAX_ROWS = 8;
// Two slots overlap QK/Softmax[n] with PV/accumulation[n - 1].
constexpr int32_t PIPE_SLOTS = 2;
// One Vector instruction supports at most 255 repeat iterations.
constexpr int64_t MAX_VECTOR_REPEATS = 255;
// Query block starts must stay aligned for ND Matmul and contiguous GM copies.
constexpr int64_t QUERY_ROW_ALIGN = 16;
// Two 128-row Cube blocks balance task overhead and AIC/AIV pipeline overlap.
constexpr int64_t PREFERRED_QUERY_BLOCK_ROWS = 256;
// SoftmaxFlashV2 stores eight float reduction values for each score row.
constexpr int64_t SOFTMAX_REDUCE_LANES = 8;
// Vector division broadcasts sixteen half denominators for each output row.
constexpr int64_t NORMALIZE_BROADCAST_LANES = 16;
// Two float broadcast regions plus one half denominator region occupy 96 bytes.
constexpr int64_t NORM_BYTES_PER_SUB_ROW =
    2 * SOFTMAX_REDUCE_LANES * sizeof(float) +
    NORMALIZE_BROADCAST_LANES * sizeof(half);
// Softmax input is half while its reduction state is accumulated in float.
constexpr uint32_t SOFTMAX_INPUT_TYPE_BYTES = sizeof(half);
constexpr uint32_t SOFTMAX_STATE_TYPE_BYTES = sizeof(float);
// The first call initializes online state; later calls update a basic block.
constexpr bool SOFTMAX_FIRST_PASS = false;
constexpr bool SOFTMAX_UPDATE_PASS = true;
constexpr bool SOFTMAX_BASIC_BLOCK = true;
constexpr AscendC::SoftmaxConfig FULL_TILE_SOFTMAX_CFG = {
    false, SOFTMAX_ROWS, KV_TILE, AscendC::SoftmaxMode::SOFTMAX_NORMAL};

// Build the shared QK/PV Matmul configuration; returns a compile-time config.
// Inputs: compile-time constants in this source configuration.
// Returns: constexpr Matmul settings shared by QK and PV.
__aicore__ constexpr MatmulConfig BuildMatmulConfig()
{
    MatmulConfig config = GetNormalConfig();
    config.enableGetTensorC = false;
    config.enableSetBias = false;
    config.enableQuantVector = false;
    config.enableSetDefineData = false;
    config.iterateMode = IterateMode::ITERATE_MODE_ALL;
    config.enableMixDualMaster = true;
    return config;
}

constexpr MatmulConfig MATMUL_CFG = BuildMatmulConfig();

// Per-slot handshake:
// AIC QK -> QkReady -> AIV Softmax -> ProbReady -> AIC PV
//        -> PvReady -> AIV accumulation -> PvDone -> AIC reuses the slot.
// Two rotating slots need eight IDs, all within the A2 range [0, 10].
// Inputs: rotating workspace slot index.
// Returns: AIC-to-AIV QK-ready event ID.
__aicore__ inline int32_t QkReadyFlag(int32_t slot)
{
    return slot * 2;
}

// Return the AIV-to-AIC event used after Softmax writes probabilities.
// Inputs: rotating workspace slot index.
// Returns: probability-ready event ID.
__aicore__ inline int32_t ProbReadyFlag(int32_t slot)
{
    return slot * 2 + 1;
}

// Return the AIC-to-AIV event used after PV writes one partial output.
// Inputs: rotating workspace slot index.
// Returns: PV-ready event ID.
__aicore__ inline int32_t PvReadyFlag(int32_t slot)
{
    return PIPE_SLOTS * 2 + slot * 2;
}

// Return the AIV-to-AIC event that allows a workspace slot to be reused.
// Inputs: rotating workspace slot index.
// Returns: PV-consumed event ID.
__aicore__ inline int32_t PvDoneFlag(int32_t slot)
{
    return PvReadyFlag(slot) + 1;
}

struct ShortAivResources {
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> scoreQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> maskQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> partialQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> probQueue;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> sumBuf;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> maxBuf;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> expMaxBuf;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> normBuf;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> tmpBuf;
};

// Allocate the short-sequence state. Two sum slots preserve normalization
// factors until the PV result for the corresponding Query task is available.
// Inputs: pipeline, resource holder, row/head dimensions, and temp bytes.
// Outputs: initializes queues, buffers, and local tensors in res.
__aicore__ inline void InitShortAivResources(
    AscendC::TPipe* pipe, ShortAivResources* res, int64_t maxSubRows,
    int64_t headDim, uint32_t smTmpBytes)
{
    using namespace AscendC;
    pipe->InitBuffer(res->scoreQueue, 1, SOFTMAX_ROWS * KV_TILE * sizeof(half));
    pipe->InitBuffer(res->maskQueue, 1, SOFTMAX_ROWS * KV_TILE * sizeof(half));
    pipe->InitBuffer(res->partialQueue, 1, maxSubRows * headDim * sizeof(half));
    pipe->InitBuffer(res->probQueue, 1, SOFTMAX_ROWS * KV_TILE * sizeof(half));
    pipe->InitBuffer(res->sumBuf, PIPE_SLOTS * maxSubRows * 8 * sizeof(float));
    pipe->InitBuffer(res->maxBuf, maxSubRows * 8 * sizeof(float));
    pipe->InitBuffer(res->expMaxBuf, maxSubRows * 16 * sizeof(half));
    pipe->InitBuffer(res->normBuf, maxSubRows * NORM_BYTES_PER_SUB_ROW);
    pipe->InitBuffer(res->tmpBuf, smTmpBytes);
}

// Apply the first or update form of online Softmax to one score tile.
// Select the full-block overload only for an exact 8x512 tile; the caller
// supplies pre-sliced sum, max, and exponent state tensors.
// Inputs: local score/state tensors, tilings, tile shape, and update flags.
// Outputs: writes probabilities and updates online Softmax state.
__aicore__ inline __attribute__((always_inline)) void OnlineSoftmax(
    AscendC::LocalTensor<half> probLocal, AscendC::LocalTensor<half> scoreLocal,
    AscendC::LocalTensor<float> tileSum, AscendC::LocalTensor<float> tileMax,
    AscendC::LocalTensor<half> tileExp, AscendC::LocalTensor<uint8_t> sharedTmp,
    const SoftMaxTiling& firstTiling,
    const SoftMaxTiling& updateTiling,
    int64_t rows, int64_t kvRows, int64_t inner)
{
    using namespace AscendC;
    SoftMaxShapeInfo shape{
        static_cast<uint32_t>(rows), static_cast<uint32_t>(kvRows),
        static_cast<uint32_t>(rows), static_cast<uint32_t>(kvRows)};
    bool isFullTile = rows == SOFTMAX_ROWS && kvRows == KV_TILE;
    if (inner == 0 && isFullTile) {
        SoftmaxFlashV2<half, false, false, true, false, FULL_TILE_SOFTMAX_CFG>(
            probLocal, tileSum, tileMax, scoreLocal, tileExp, tileSum, tileMax,
            sharedTmp, firstTiling, shape);
    } else if (inner == 0) {
        SoftmaxFlashV2<half, false, false, true>(
            probLocal, tileSum, tileMax, scoreLocal, tileExp, tileSum, tileMax,
            sharedTmp, firstTiling, shape);
    } else if (isFullTile) {
        SoftmaxFlashV2<half, true, false, true, false, FULL_TILE_SOFTMAX_CFG>(
            probLocal, tileSum, tileMax, scoreLocal, tileExp, tileSum, tileMax,
            sharedTmp, updateTiling, shape);
    } else {
        SoftmaxFlashV2<half, true, false, true>(
            probLocal, tileSum, tileMax, scoreLocal, tileExp, tileSum, tileMax,
            sharedTmp, updateTiling, shape);
    }
}

// Scale and mask up to eight score rows, then write probabilities to GM.
// The caller supplies score, probability, and mask slices at the row offset.
// Inputs: queues, GM slices, state tensors, tilings, shape, scale, and mask flag.
// Outputs: writes one probability row group to probDst.
__aicore__ inline __attribute__((always_inline)) void RunSoftmaxRows(
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* scoreQueue,
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* maskQueue,
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1>* probQueue,
    AscendC::GlobalTensor<half> scoreSrc, AscendC::GlobalTensor<half> probDst,
    AscendC::GlobalTensor<half> maskSrc,
    AscendC::LocalTensor<float> tileSum, AscendC::LocalTensor<float> tileMax,
    AscendC::LocalTensor<half> tileExp, AscendC::LocalTensor<uint8_t> sharedTmp,
    const SoftMaxTiling& firstTiling,
    const SoftMaxTiling& updateTiling,
    int64_t rows, int64_t kvRows, int64_t seqLen, float scale, int64_t inner,
    bool useMask)
{
    using namespace AscendC;
    int64_t elemCount = rows * kvRows;
    LocalTensor<half> scoreLocal = scoreQueue->AllocTensor<half>();
    DataCopy(scoreLocal, scoreSrc, elemCount);
    scoreQueue->EnQue(scoreLocal);
    scoreLocal = scoreQueue->DeQue<half>();
    Muls(scoreLocal, scoreLocal, static_cast<half>(scale), elemCount);
    PipeBarrier<PIPE_V>();
    if (useMask) {
        LocalTensor<half> maskLocal = maskQueue->AllocTensor<half>();
        DataCopyParams maskCopy{
            static_cast<uint16_t>(rows),
            static_cast<uint16_t>(kvRows * sizeof(half) / 32),
            static_cast<uint16_t>((seqLen - kvRows) * sizeof(half) / 32), 0};
        DataCopy(maskLocal, maskSrc, maskCopy);
        maskQueue->EnQue(maskLocal);
        maskLocal = maskQueue->DeQue<half>();
        Add(scoreLocal, scoreLocal, maskLocal, elemCount);
        PipeBarrier<PIPE_V>();
        maskQueue->FreeTensor(maskLocal);
    }
    LocalTensor<half> probLocal = probQueue->AllocTensor<half>();
    OnlineSoftmax(probLocal, scoreLocal, tileSum, tileMax, tileExp, sharedTmp,
                  firstTiling, updateTiling, rows, kvRows, inner);
    scoreQueue->FreeTensor(scoreLocal);
    probQueue->EnQue(probLocal);
    probLocal = probQueue->DeQue<half>();
    DataCopy(probDst, probLocal, elemCount);
    probQueue->FreeTensor(probLocal);
}

// Merge one PV tile into accState using the online-softmax rescale factor.
// partialGm already points at the current slot; event synchronization remains
// in the caller so this helper only copies and updates Vector state.
// Inputs: PV queue/tensor, online state, slot geometry, and first-tile flag.
// Outputs: updates accState in UB.
__aicore__ inline __attribute__((always_inline)) void AccumulatePartial(
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* partialQueue,
    AscendC::GlobalTensor<half> partialGm, AscendC::LocalTensor<half> accState,
    AscendC::LocalTensor<half> expMaxState, int32_t slot, int64_t maxSubRows,
    int64_t rowOffset, int64_t subRows, int64_t headDim, bool isFirst)
{
    using namespace AscendC;
    LocalTensor<half> partialLocal = partialQueue->AllocTensor<half>();
    DataCopy(partialLocal, partialGm[rowOffset * headDim], subRows * headDim);
    partialQueue->EnQue(partialLocal);
    partialLocal = partialQueue->DeQue<half>();
    if (isFirst) {
        Adds(accState, partialLocal, static_cast<half>(0), subRows * headDim);
    } else {
        BinaryRepeatParams mulParams;
        mulParams.src0BlkStride = 0;
        mulParams.src0RepStride = 1;
        mulParams.src1BlkStride = 1;
        mulParams.src1RepStride = headDim / 16;
        mulParams.dstBlkStride = 1;
        mulParams.dstRepStride = headDim / 16;
        LocalTensor<half> pvExp = expMaxState[slot * maxSubRows * 16];
        Mul(accState, pvExp, accState, headDim, subRows, mulParams);
        PipeBarrier<PIPE_V>();
        Add(accState, partialLocal, accState, subRows * headDim);
    }
    PipeBarrier<PIPE_V>();
    partialQueue->FreeTensor(partialLocal);
}

// Normalize accumulated rows with sumState and write the final output to GM.
// Broadcast each row sum, divide the accumulated values, then synchronize
// Vector-to-MTE3 before copying ioTensor to global memory.
// Inputs: pipeline/buffer state, output slice, row count, and head dimension.
// Outputs: writes normalized rows to outGm.
__aicore__ inline __attribute__((always_inline)) void NormalizeAndStore(
    AscendC::TPipe* pipe,
    AscendC::TBuf<AscendC::QuePosition::VECCALC>* normBuf,
    AscendC::LocalTensor<float> sumState, AscendC::LocalTensor<half> ioTensor,
    AscendC::GlobalTensor<half> outGm, int64_t subRows, int64_t headDim)
{
    using namespace AscendC;
    int64_t reduceCount = subRows * 8;
    LocalTensor<float> normFloat = normBuf->Get<float>();
    LocalTensor<half> normHalf = normFloat[reduceCount * 2].ReinterpretCast<half>();
    CopyRepeatParams copyParams{2, 1, 16, 8};
    int32_t repeats = (reduceCount + 63) / 64;
    Copy(normFloat, sumState, 64, repeats, copyParams);
    Copy(normFloat[8], sumState, 64, repeats, copyParams);
    PipeBarrier<PIPE_V>();
    Cast(normHalf, normFloat, RoundMode::CAST_ROUND, reduceCount * 2);
    PipeBarrier<PIPE_V>();
    BinaryRepeatParams divParams;
    divParams.src0BlkStride = 1;
    divParams.src0RepStride = headDim / 16;
    divParams.src1BlkStride = 0;
    divParams.src1RepStride = 1;
    divParams.dstBlkStride = 1;
    divParams.dstRepStride = headDim / 16;
    for (int64_t rowStart = 0; rowStart < subRows; rowStart += MAX_VECTOR_REPEATS) {
        int64_t rows = subRows - rowStart;
        if (rows > MAX_VECTOR_REPEATS) {
            rows = MAX_VECTOR_REPEATS;
        }
        LocalTensor<half> ioChunk = ioTensor[rowStart * headDim];
        LocalTensor<half> normChunk = normHalf[rowStart * 16];
        Div(ioChunk, ioChunk, normChunk, headDim, rows, divParams);
    }
    PipeBarrier<PIPE_V>();
    event_t vToMte3 = static_cast<event_t>(pipe->FetchEventID(HardEvent::V_MTE3));
    SetFlag<HardEvent::V_MTE3>(vToMte3);
    WaitFlag<HardEvent::V_MTE3>(vToMte3);
    DataCopy(outGm, ioTensor, subRows * headDim);
}

// Process one QK result and publish its unnormalized probability tile.
// Inputs: short-path AIV resources, GM tensors, tilings, task/slot, and geometry.
// Outputs: writes probability data and signals the AIC consumer.
__aicore__ inline void RunShortSoftmaxTask(
    ShortAivResources* res, __gm__ half* mask, __gm__ half* scoreGm,
    __gm__ half* probGm, const SoftMaxTiling& firstTiling,
    int32_t coreIdx, int32_t taskIdx, int32_t slot, int64_t seqLen,
    float scale, int64_t blockRows, int64_t chunksPerHead)
{
    using namespace AscendC;
    int64_t subIdx = GetSubBlockIdx();
    int64_t maxSubRows = (blockRows + 1) / 2;
    int64_t headIdx = taskIdx / chunksPerHead;
    int64_t chunkIdx = taskIdx - headIdx * chunksPerHead;
    int64_t chunkRowStart = chunkIdx * blockRows;
    int64_t qRows = seqLen - chunkRowStart;
    qRows = qRows > blockRows ? blockRows : qRows;
    int64_t kvRows = chunkRowStart + qRows;
    int64_t firstRows = (qRows + 1) / 2;
    int64_t rowOffset = subIdx * firstRows;
    int64_t subRows = firstRows + subIdx * (qRows - firstRows * 2);
    int64_t slotBase = (coreIdx * PIPE_SLOTS + slot) * blockRows;
    GlobalTensor<half> score, prob, maskTensor;
    score.SetGlobalBuffer(scoreGm + slotBase * KV_TILE);
    prob.SetGlobalBuffer(probGm + slotBase * KV_TILE);
    maskTensor.SetGlobalBuffer(mask + chunkRowStart * seqLen);
    LocalTensor<float> sumState = res->sumBuf.Get<float>();
    LocalTensor<float> maxState = res->maxBuf.Get<float>();
    LocalTensor<half> expMaxState = res->expMaxBuf.Get<half>();
    LocalTensor<uint8_t> sharedTmp = res->tmpBuf.Get<uint8_t>();

    CrossCoreWaitFlag(QkReadyFlag(slot));
    for (int64_t done = 0; done < subRows; done += SOFTMAX_ROWS) {
        int64_t rows = subRows - done;
        rows = rows > SOFTMAX_ROWS ? SOFTMAX_ROWS : rows;
        int64_t gmRow = rowOffset + done;
        LocalTensor<float> tileSum = sumState[(slot * maxSubRows + done) * 8];
        LocalTensor<float> tileMax = maxState[done * 8];
        LocalTensor<half> tileExp = expMaxState[done * 16];
        RunSoftmaxRows(
            &res->scoreQueue, &res->maskQueue, &res->probQueue,
            score[gmRow * kvRows], prob[gmRow * kvRows],
            maskTensor[gmRow * seqLen], tileSum, tileMax, tileExp, sharedTmp,
            firstTiling, firstTiling, rows, kvRows, seqLen, scale, 0,
            kvRows > chunkRowStart);
    }
    CrossCoreSetFlag<2, PIPE_MTE3>(ProbReadyFlag(slot));
}

// Normalize one PV result with the sum retained by its Softmax task.
// Inputs: pipeline/resources, PV/output tensors, task/slot, and geometry.
// Outputs: writes normalized output rows and releases the slot.
__aicore__ inline void FinishShortPvTask(
    AscendC::TPipe* pipe, ShortAivResources* res, __gm__ half* out,
    __gm__ half* partialGm, int32_t coreIdx, int32_t taskIdx, int32_t slot,
    int64_t seqLen, int64_t headDim, int64_t blockRows,
    int64_t chunksPerHead)
{
    using namespace AscendC;
    int64_t subIdx = GetSubBlockIdx();
    int64_t maxSubRows = (blockRows + 1) / 2;
    int64_t headIdx = taskIdx / chunksPerHead;
    int64_t chunkIdx = taskIdx - headIdx * chunksPerHead;
    int64_t chunkRowStart = chunkIdx * blockRows;
    int64_t qRows = seqLen - chunkRowStart;
    qRows = qRows > blockRows ? blockRows : qRows;
    int64_t qRowStart = headIdx * seqLen + chunkRowStart;
    int64_t firstRows = (qRows + 1) / 2;
    int64_t rowOffset = subIdx * firstRows;
    int64_t subRows = firstRows + subIdx * (qRows - firstRows * 2);
    int64_t slotBase = (coreIdx * PIPE_SLOTS + slot) * blockRows;
    GlobalTensor<half> partial, outTensor;
    partial.SetGlobalBuffer(partialGm + slotBase * headDim);
    outTensor.SetGlobalBuffer(out + (qRowStart + rowOffset) * headDim);

    CrossCoreWaitFlag(PvReadyFlag(slot));
    LocalTensor<half> partialLocal = res->partialQueue.AllocTensor<half>();
    DataCopy(partialLocal, partial[rowOffset * headDim], subRows * headDim);
    res->partialQueue.EnQue(partialLocal);
    partialLocal = res->partialQueue.DeQue<half>();
    LocalTensor<float> sumState = res->sumBuf.Get<float>();
    LocalTensor<float> slotSum = sumState[slot * maxSubRows * 8];
    NormalizeAndStore(pipe, &res->normBuf, slotSum, partialLocal, outTensor,
                      subRows, headDim);
    res->partialQueue.FreeTensor(partialLocal);
    CrossCoreSetFlag<2, PIPE_MTE3>(PvDoneFlag(slot));
}

// Overlap QK/Softmax for task n with PV/normalization for task n - 1.
// Inputs: pipeline, GM tensors, tilings, core task range, and launch geometry.
// Outputs: completes all assigned short-sequence AIV tasks.
__aicore__ inline void RunShortAivPath(
    AscendC::TPipe* pipe, __gm__ half* mask, __gm__ half* out,
    __gm__ half* scoreGm, __gm__ half* probGm, __gm__ half* partialGm,
    __gm__ SoftMaxTiling* smTiling, uint32_t smTmpBytes,
    int32_t coreIdx, int32_t taskBegin, int32_t taskEnd, int64_t seqLen,
    int64_t headDim, float scale, int64_t blockRows,
    int64_t chunksPerHead)
{
    using namespace AscendC;
    ShortAivResources res;
    InitShortAivResources(pipe, &res, (blockRows + 1) / 2, headDim, smTmpBytes);
    SoftMaxTiling firstTiling;
    for (size_t i = 0; i < sizeof(SoftMaxTiling); ++i) {
        reinterpret_cast<uint8_t*>(&firstTiling)[i] =
            reinterpret_cast<__gm__ uint8_t*>(smTiling)[i];
    }
    int32_t taskCount = taskEnd - taskBegin;
    for (int32_t step = 0; step < taskCount + 1; ++step) {
        if (step < taskCount) {
            int32_t slot = step % PIPE_SLOTS;
            RunShortSoftmaxTask(
                &res, mask, scoreGm, probGm, firstTiling, coreIdx,
                taskBegin + step, slot, seqLen, scale, blockRows,
                chunksPerHead);
        }
        if (step >= 1) {
            int32_t pvStep = step - 1;
            FinishShortPvTask(
                pipe, &res, out, partialGm, coreIdx, taskBegin + pvStep,
                pvStep % PIPE_SLOTS, seqLen, headDim, blockRows,
                chunksPerHead);
        }
    }
}

// Run AIV Softmax for one KV tile and consume the previous PV result.
// Wait for QK, publish probabilities, and from the second tile onward merge
// the preceding PV result into the online output accumulator.
// Inputs: AIV resources, GM tensors, online state, task geometry, and tilings.
// Outputs: publishes probabilities and updates accumulated output state.
__aicore__ inline __attribute__((always_inline)) void ProcessAivTile(
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* scoreQueue,
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* maskQueue,
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* partialQueue,
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1>* probQueue,
    __gm__ half* scoreGm, __gm__ half* probGm, __gm__ half* partialGm,
    __gm__ half* maskGm, AscendC::LocalTensor<float> sumState,
    AscendC::LocalTensor<float> maxState,
    AscendC::LocalTensor<half> expMaxState, AscendC::LocalTensor<half> accState,
    AscendC::LocalTensor<uint8_t> sharedTmp, const SoftMaxTiling& firstTiling,
    const SoftMaxTiling& updateTiling, int32_t coreIdx, int64_t inner,
    int64_t effectiveKv, int64_t chunkRowStart, int64_t rowOffset,
    int64_t subRows, int64_t seqLen, int64_t headDim, float scale,
    int64_t blockRows, int64_t maxSubRows)
{
    using namespace AscendC;
    int32_t slot = inner % PIPE_SLOTS;
    int64_t kvStart = inner * KV_TILE;
    int64_t kvRows = effectiveKv - kvStart;
    if (kvRows > KV_TILE) {
        kvRows = KV_TILE;
    }
    int64_t slotBase = (coreIdx * PIPE_SLOTS + slot) * blockRows;
    GlobalTensor<half> score, prob, maskTensor;
    score.SetGlobalBuffer(scoreGm + slotBase * KV_TILE);
    prob.SetGlobalBuffer(probGm + slotBase * KV_TILE);
    maskTensor.SetGlobalBuffer(maskGm + chunkRowStart * seqLen + kvStart);

    CrossCoreWaitFlag(QkReadyFlag(slot));
    for (int64_t done = 0; done < subRows; done += SOFTMAX_ROWS) {
        int64_t rows = subRows - done;
        if (rows > SOFTMAX_ROWS) {
            rows = SOFTMAX_ROWS;
        }
        int64_t gmRow = rowOffset + done;
        LocalTensor<float> tileSum = sumState[done * 8];
        LocalTensor<float> tileMax = maxState[done * 8];
        LocalTensor<half> tileExp = expMaxState[(slot * maxSubRows + done) * 16];
        RunSoftmaxRows(scoreQueue, maskQueue, probQueue, score[gmRow * kvRows],
                       prob[gmRow * kvRows], maskTensor[gmRow * seqLen],
                       tileSum, tileMax, tileExp, sharedTmp, firstTiling,
                       updateTiling, rows, kvRows, seqLen, scale, inner,
                       kvStart + kvRows > chunkRowStart);
    }
    CrossCoreSetFlag<2, PIPE_MTE3>(ProbReadyFlag(slot));

    if (inner >= 1) {
        int64_t pvInner = inner - 1;
        int32_t pvSlot = pvInner % PIPE_SLOTS;
        int64_t pvBase = (coreIdx * PIPE_SLOTS + pvSlot) * blockRows;
        GlobalTensor<half> pvPartial;
        pvPartial.SetGlobalBuffer(partialGm + pvBase * headDim);
        CrossCoreWaitFlag(PvReadyFlag(pvSlot));
        AccumulatePartial(partialQueue, pvPartial, accState, expMaxState, pvSlot,
                          maxSubRows, rowOffset, subRows, headDim, pvInner == 0);
        CrossCoreSetFlag<2, PIPE_MTE3>(PvDoneFlag(pvSlot));
    }
}

// Drain the final PV tile, normalize the task output, and release its slot.
// The last slot remains owned until output normalization has consumed its data.
// Inputs: AIV pipeline state, GM tensors, task geometry, and inner-block count.
// Outputs: writes final output rows and releases the rotating slot.
__aicore__ inline __attribute__((always_inline)) void FinishAivTask(
    AscendC::TPipe* pipe,
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* partialQueue,
    __gm__ half* partialGm, __gm__ half* outGm,
    AscendC::LocalTensor<half> expMaxState, AscendC::LocalTensor<half> accState,
    AscendC::TBuf<AscendC::QuePosition::VECCALC>* normBuf,
    AscendC::LocalTensor<float> sumState,
    int32_t coreIdx, int64_t qRowStart, int64_t rowOffset, int64_t subRows,
    int64_t headDim, int64_t blockRows, int64_t maxSubRows, int64_t innerBlocks)
{
    using namespace AscendC;
    int64_t flushStart = innerBlocks - 1;
    int32_t lastSlot = 0;
    for (int64_t pvInner = flushStart; pvInner < innerBlocks; ++pvInner) {
        int32_t pvSlot = pvInner % PIPE_SLOTS;
        int64_t pvBase = (coreIdx * PIPE_SLOTS + pvSlot) * blockRows;
        GlobalTensor<half> pvPartial;
        pvPartial.SetGlobalBuffer(partialGm + pvBase * headDim);
        CrossCoreWaitFlag(PvReadyFlag(pvSlot));
        AccumulatePartial(partialQueue, pvPartial, accState, expMaxState, pvSlot,
                          maxSubRows, rowOffset, subRows, headDim, pvInner == 0);
        if (pvInner + 1 < innerBlocks) {
            CrossCoreSetFlag<2, PIPE_MTE3>(PvDoneFlag(pvSlot));
        }
        lastSlot = pvSlot;
    }
    GlobalTensor<half> outTensor;
    outTensor.SetGlobalBuffer(outGm + (qRowStart + rowOffset) * headDim);
    NormalizeAndStore(pipe, normBuf, sumState, accState, outTensor, subRows,
                      headDim);
    CrossCoreSetFlag<2, PIPE_MTE3>(PvDoneFlag(lastSlot));
}

// Execute all online-softmax and accumulation stages for one AIV task.
// Inputs: AIV resources, GM tensors, task index, and launch geometry.
// Outputs: completes the Vector-side work for one Query task.
__aicore__ inline __attribute__((always_inline)) void RunAivTask(
    AscendC::TPipe* pipe,
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* scoreQueue,
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* maskQueue,
    AscendC::TQue<AscendC::QuePosition::VECIN, 1>* partialQueue,
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1>* probQueue,
    __gm__ half* scoreGm, __gm__ half* probGm, __gm__ half* partialGm,
    __gm__ half* maskGm, __gm__ half* outGm, AscendC::LocalTensor<float> sumState,
    AscendC::LocalTensor<float> maxState, AscendC::LocalTensor<half> expMaxState,
    AscendC::LocalTensor<half> accState, AscendC::LocalTensor<uint8_t> sharedTmp,
    AscendC::TBuf<AscendC::QuePosition::VECCALC>* normBuf,
    const SoftMaxTiling& firstTiling, const SoftMaxTiling& updateTiling,
    int32_t coreIdx, int32_t taskIdx, int64_t seqLen, int64_t headDim,
    float scale, int64_t blockRows, int64_t chunksPerHead, int64_t maxSubRows,
    int64_t subIdx)
{
    int64_t headIdx = taskIdx / chunksPerHead;
    int64_t chunkIdx = taskIdx - headIdx * chunksPerHead;
    int64_t chunkRowStart = chunkIdx * blockRows;
    int64_t qRows = seqLen - chunkRowStart;
    if (qRows > blockRows) {
        qRows = blockRows;
    }
    int64_t effectiveKv = chunkRowStart + qRows;
    int64_t qRowStart = headIdx * seqLen + chunkRowStart;
    int64_t firstRows = (qRows + 1) / 2;
    int64_t rowOffset = subIdx * firstRows;
    int64_t subRows = firstRows + subIdx * (qRows - firstRows * 2);
    int64_t innerBlocks = (effectiveKv + KV_TILE - 1) / KV_TILE;
    for (int64_t inner = 0; inner < innerBlocks; ++inner) {
        ProcessAivTile(
            scoreQueue, maskQueue, partialQueue, probQueue, scoreGm, probGm,
            partialGm, maskGm, sumState, maxState, expMaxState, accState,
            sharedTmp, firstTiling, updateTiling, coreIdx, inner, effectiveKv,
            chunkRowStart, rowOffset, subRows, seqLen, headDim, scale,
            blockRows, maxSubRows);
    }
    FinishAivTask(
        pipe, partialQueue, partialGm, outGm, expMaxState, accState, normBuf,
        sumState, coreIdx, qRowStart, rowOffset, subRows, headDim, blockRows,
        maxSubRows, innerBlocks);
}

// Run the Vector-side online Softmax, PV accumulation, and output writeback.
// Inputs: pipeline, GM addresses, tilings, core task range, and launch geometry.
// Outputs: writes this AIV sub-core's output rows.
__aicore__ inline void RunAivPath(
    AscendC::TPipe* pipe, __gm__ half* mask, __gm__ half* out, __gm__ half* scoreGm, __gm__ half* probGm,
    __gm__ half* partialGm, __gm__ SoftMaxTiling* smTiling, uint32_t smTmpBytes, int32_t coreIdx,
    int32_t taskBegin, int32_t taskEnd, int64_t seqLen, int64_t headDim, float scale, int64_t blockRows,
    int64_t chunksPerHead)
{
    using namespace AscendC;
    // Queue tensors move one score tile through MTE2, Vector, and MTE3.
    // TBuf tensors keep online-softmax state alive across all KV tiles.
    TQue<QuePosition::VECIN, 1> scoreQueue, maskQueue, partialQueue;
    TQue<QuePosition::VECOUT, 1> probQueue;
    TBuf<QuePosition::VECCALC> sumBuf, maxBuf, expMaxBuf, accBuf, normBuf, tmpBuf;
    int64_t subIdx = GetSubBlockIdx();
    int64_t maxSubRows = (blockRows + 1) / 2;
    pipe->InitBuffer(scoreQueue, 1, SOFTMAX_ROWS * KV_TILE * sizeof(half));
    pipe->InitBuffer(maskQueue, 1, SOFTMAX_ROWS * KV_TILE * sizeof(half));
    pipe->InitBuffer(partialQueue, 1, maxSubRows * headDim * sizeof(half));
    pipe->InitBuffer(probQueue, 1, SOFTMAX_ROWS * KV_TILE * sizeof(half));
    pipe->InitBuffer(sumBuf, maxSubRows * 8 * sizeof(float));
    pipe->InitBuffer(maxBuf, maxSubRows * 8 * sizeof(float));
    pipe->InitBuffer(expMaxBuf, PIPE_SLOTS * maxSubRows * 16 * sizeof(half));
    pipe->InitBuffer(accBuf, maxSubRows * headDim * sizeof(half));
    pipe->InitBuffer(normBuf, maxSubRows * NORM_BYTES_PER_SUB_ROW);
    pipe->InitBuffer(tmpBuf, smTmpBytes);

    // Copy host-generated first/update tilings into scalar addressable memory.
    SoftMaxTiling firstTiling, updateTiling;
    for (size_t i = 0; i < sizeof(SoftMaxTiling); ++i) {
        reinterpret_cast<uint8_t*>(&firstTiling)[i] = reinterpret_cast<__gm__ uint8_t*>(smTiling)[i];
        reinterpret_cast<uint8_t*>(&updateTiling)[i] = reinterpret_cast<__gm__ uint8_t*>(smTiling + 1)[i];
    }
    LocalTensor<float> sumState = sumBuf.Get<float>();
    LocalTensor<float> maxState = maxBuf.Get<float>();
    LocalTensor<half> expMaxState = expMaxBuf.Get<half>();
    LocalTensor<half> accState = accBuf.Get<half>();
    LocalTensor<uint8_t> sharedTmp = tmpBuf.Get<uint8_t>();

    // Each task owns one batch/head/Query-row block.
    for (int32_t taskIdx = taskBegin; taskIdx < taskEnd; ++taskIdx) {
        RunAivTask(
            pipe, &scoreQueue, &maskQueue, &partialQueue, &probQueue, scoreGm,
            probGm, partialGm, mask, out, sumState, maxState, expMaxState,
            accState, sharedTmp, &normBuf, firstTiling, updateTiling, coreIdx,
            taskIdx, seqLen, headDim, scale, blockRows, chunksPerHead,
            maxSubRows, subIdx);
    }
}

// Produce one compact QK tile for the short-sequence task.
// Inputs: QK Matmul, Q/K/score tensors, task/slot, and launch geometry.
// Outputs: writes one score tile and signals the AIV consumer.
template <typename MatmulQK>
__aicore__ inline void RunShortQkTask(
    MatmulQK& mmQK, __gm__ half* q, __gm__ half* k, __gm__ half* scoreGm,
    int32_t coreIdx, int32_t taskIdx, int32_t slot, int64_t seqLen,
    int64_t headDim, int64_t blockRows, int64_t chunksPerHead)
{
    using namespace AscendC;
    int64_t headIdx = taskIdx / chunksPerHead;
    int64_t chunkIdx = taskIdx - headIdx * chunksPerHead;
    int64_t chunkRowStart = chunkIdx * blockRows;
    int64_t qRows = seqLen - chunkRowStart;
    qRows = qRows > blockRows ? blockRows : qRows;
    int64_t kvRows = chunkRowStart + qRows;
    int64_t headRowStart = headIdx * seqLen;
    int64_t slotBase = (coreIdx * PIPE_SLOTS + slot) * blockRows;
    GlobalTensor<half> qTensor, kTensor, score;
    qTensor.SetGlobalBuffer(q + (headRowStart + chunkRowStart) * headDim);
    kTensor.SetGlobalBuffer(k + headRowStart * headDim);
    score.SetGlobalBuffer(scoreGm + slotBase * KV_TILE);
    mmQK.SetOrgShape(qRows, kvRows, headDim, headDim);
    mmQK.SetTensorA(qTensor, false);
    mmQK.SetTensorB(kTensor, true);
    mmQK.SetTail(qRows, kvRows, -1);
    mmQK.template IterateAll<true>(score, 0, false, true, false);
    PipeBarrier<PIPE_ALL>();
    CrossCoreSetFlag<2, PIPE_FIX>(QkReadyFlag(slot));
}

// Consume one probability tile and publish its PV result.
// Inputs: PV Matmul, V/probability/output tensors, task/slot, and geometry.
// Outputs: writes one partial output tile and signals the AIV consumer.
template <typename MatmulPV>
__aicore__ inline void RunShortPvTask(
    MatmulPV& mmPV, __gm__ half* v, __gm__ half* probGm,
    __gm__ half* partialGm, int32_t coreIdx, int32_t taskIdx,
    int32_t slot, int64_t seqLen, int64_t headDim, int64_t blockRows,
    int64_t chunksPerHead)
{
    using namespace AscendC;
    int64_t headIdx = taskIdx / chunksPerHead;
    int64_t chunkIdx = taskIdx - headIdx * chunksPerHead;
    int64_t chunkRowStart = chunkIdx * blockRows;
    int64_t qRows = seqLen - chunkRowStart;
    qRows = qRows > blockRows ? blockRows : qRows;
    int64_t kvRows = chunkRowStart + qRows;
    int64_t headRowStart = headIdx * seqLen;
    int64_t slotBase = (coreIdx * PIPE_SLOTS + slot) * blockRows;
    GlobalTensor<half> prob, value, partial;
    prob.SetGlobalBuffer(probGm + slotBase * KV_TILE);
    value.SetGlobalBuffer(v + headRowStart * headDim);
    partial.SetGlobalBuffer(partialGm + slotBase * headDim);
    CrossCoreWaitFlag(ProbReadyFlag(slot));
    mmPV.SetOrgShape(qRows, headDim, kvRows, headDim);
    mmPV.SetTensorA(prob, false);
    mmPV.SetTensorB(value, false);
    mmPV.SetTail(qRows, headDim, kvRows);
    mmPV.template IterateAll<true>(partial, 0, false, false, false);
    PipeBarrier<PIPE_ALL>();
    CrossCoreSetFlag<2, PIPE_FIX>(PvReadyFlag(slot));
}

// Overlap QK for task n with PV for task n - 1 using two legal event slots.
// Inputs: QK/PV state, GM tensors, core task range, and launch geometry.
// Outputs: submits all short-sequence Cube work and drains pending slots.
template <typename MatmulQK, typename MatmulPV>
__aicore__ inline void RunShortAicTasks(
    MatmulQK& mmQK, MatmulPV& mmPV, __gm__ half* q, __gm__ half* k,
    __gm__ half* v, __gm__ half* scoreGm, __gm__ half* probGm,
    __gm__ half* partialGm, int32_t coreIdx, int32_t taskBegin,
    int32_t taskEnd, int64_t seqLen, int64_t headDim, int64_t blockRows,
    int64_t chunksPerHead)
{
    bool pvPending[PIPE_SLOTS] = {false, false};
    int32_t taskCount = taskEnd - taskBegin;
    for (int32_t step = 0; step < taskCount + 1; ++step) {
        if (step < taskCount) {
            int32_t slot = step % PIPE_SLOTS;
            if (pvPending[slot]) {
                AscendC::CrossCoreWaitFlag(PvDoneFlag(slot));
                pvPending[slot] = false;
            }
            RunShortQkTask(
                mmQK, q, k, scoreGm, coreIdx, taskBegin + step, slot,
                seqLen, headDim, blockRows, chunksPerHead);
        }
        if (step >= 1) {
            int32_t pvStep = step - 1;
            int32_t slot = pvStep % PIPE_SLOTS;
            RunShortPvTask(
                mmPV, v, probGm, partialGm, coreIdx, taskBegin + pvStep,
                slot, seqLen, headDim, blockRows, chunksPerHead);
            pvPending[slot] = true;
        }
    }
    for (int32_t slot = 0; slot < PIPE_SLOTS; ++slot) {
        if (pvPending[slot]) {
            AscendC::CrossCoreWaitFlag(PvDoneFlag(slot));
        }
    }
}

// Run one Probability x Value tile and signal the AIV consumer.
// Wait for probabilities before Matmul; slot-reuse waiting and pending-state
// bookkeeping remain in the caller.
// Inputs: PV Matmul, pre-sliced tensors, tile dimensions, and event slot.
// Outputs: writes one partial output tile and publishes its event.
template <typename MatmulPV>
__aicore__ inline __attribute__((always_inline)) void RunPv(
    MatmulPV& mmPV, AscendC::GlobalTensor<half> prob,
    AscendC::GlobalTensor<half> value, AscendC::GlobalTensor<half> partial,
    int64_t qRows, int64_t headDim, int64_t kvRows, int32_t slot)
{
    using namespace AscendC;
    int32_t flagSlot = slot % PIPE_SLOTS;
    CrossCoreWaitFlag(ProbReadyFlag(flagSlot));
    mmPV.SetOrgShape(qRows, headDim, kvRows, headDim);
    mmPV.SetTensorA(prob, false);
    mmPV.SetTensorB(value, false);
    mmPV.SetTail(qRows, headDim, kvRows);
    mmPV.template IterateAll<true>(partial, 0, false, false, false);
    PipeBarrier<PIPE_ALL>();
    CrossCoreSetFlag<2, PIPE_FIX>(PvReadyFlag(flagSlot));
}

// Drain the final PV tile after the main QK loop and clear pending slots.
// Inputs: PV state, GM tensors, task geometry, and inner-block count.
// Outputs: writes remaining PV tiles and clears pending slot flags.
template <typename MatmulPV>
__aicore__ inline __attribute__((always_inline)) void FlushPvTiles(
    MatmulPV& mmPV, bool* pvPending, __gm__ half* probGm, __gm__ half* vGm,
    __gm__ half* partialGm, int32_t coreIdx, int64_t headRowStart,
    int64_t qRows, int64_t effectiveKv, int64_t headDim, int64_t blockRows,
    int64_t innerBlocks)
{
    using namespace AscendC;
    int64_t flushStart = innerBlocks - 1;
    for (int64_t flush = flushStart; flush < innerBlocks; ++flush) {
        int32_t slot = flush % PIPE_SLOTS;
        int64_t kvStart = flush * KV_TILE;
        int64_t kvRows = effectiveKv - kvStart;
        if (kvRows > KV_TILE) {
            kvRows = KV_TILE;
        }
        int64_t slotBase = (coreIdx * PIPE_SLOTS + slot) * blockRows;
        if (pvPending[slot]) {
            CrossCoreWaitFlag(PvDoneFlag(slot));
            pvPending[slot] = false;
        }
        GlobalTensor<half> prob, value, partial;
        prob.SetGlobalBuffer(probGm + slotBase * KV_TILE);
        value.SetGlobalBuffer(vGm + (headRowStart + kvStart) * headDim);
        partial.SetGlobalBuffer(partialGm + slotBase * headDim);
        RunPv(mmPV, prob, value, partial, qRows, headDim, kvRows, flush);
        pvPending[slot] = true;
    }
    for (int32_t slot = 0; slot < PIPE_SLOTS; ++slot) {
        if (pvPending[slot]) {
            CrossCoreWaitFlag(PvDoneFlag(slot));
            pvPending[slot] = false;
        }
    }
}

// Execute QK tiles while overlapping PV work from the previous iteration.
// Inputs: QK/PV state, GM tensors, task index, and launch geometry.
// Outputs: writes score/PV intermediates and drains the final PV tile.
template <typename MatmulQK, typename MatmulPV>
__aicore__ inline __attribute__((always_inline)) void RunAicTask(
    MatmulQK& mmQK, MatmulPV& mmPV, bool* pvPending, __gm__ half* qGm,
    __gm__ half* kGm, __gm__ half* vGm, __gm__ half* scoreGm,
    __gm__ half* probGm, __gm__ half* partialGm, int32_t coreIdx,
    int32_t taskIdx, int64_t seqLen, int64_t headDim, int64_t blockRows,
    int64_t chunksPerHead)
{
    using namespace AscendC;
    int64_t headIdx = taskIdx / chunksPerHead;
    int64_t chunkIdx = taskIdx - headIdx * chunksPerHead;
    int64_t chunkRowStart = chunkIdx * blockRows;
    int64_t qRows = seqLen - chunkRowStart;
    if (qRows > blockRows) {
        qRows = blockRows;
    }
    int64_t effectiveKv = chunkRowStart + qRows;
    int64_t headRowStart = headIdx * seqLen;
    int64_t qRowStart = headRowStart + chunkRowStart;
    int64_t innerBlocks = (effectiveKv + KV_TILE - 1) / KV_TILE;

    for (int64_t inner = 0; inner < innerBlocks; ++inner) {
        int32_t slot = inner % PIPE_SLOTS;
        int64_t kvStart = inner * KV_TILE;
        int64_t kvRows = effectiveKv - kvStart;
        if (kvRows > KV_TILE) {
            kvRows = KV_TILE;
        }
        int64_t slotBase = (coreIdx * PIPE_SLOTS + slot) * blockRows;
        GlobalTensor<half> qTensor, kTensor, score;
        qTensor.SetGlobalBuffer(qGm + qRowStart * headDim);
        kTensor.SetGlobalBuffer(kGm + (headRowStart + kvStart) * headDim);
        score.SetGlobalBuffer(scoreGm + slotBase * KV_TILE);
        mmQK.SetOrgShape(qRows, kvRows, headDim, headDim);
        mmQK.SetTensorA(qTensor, false);
        mmQK.SetTensorB(kTensor, true);
        mmQK.SetTail(qRows, kvRows, -1);
        mmQK.template IterateAll<true>(score, 0, false, true, false);
        PipeBarrier<PIPE_ALL>();
        CrossCoreSetFlag<2, PIPE_FIX>(QkReadyFlag(slot));

        if (inner >= 1) {
            int64_t prev = inner - 1;
            int32_t prevSlot = prev % PIPE_SLOTS;
            int64_t prevStart = prev * KV_TILE;
            int64_t prevRows = effectiveKv - prevStart;
            if (prevRows > KV_TILE) {
                prevRows = KV_TILE;
            }
            int64_t prevBase = (coreIdx * PIPE_SLOTS + prevSlot) * blockRows;
            if (pvPending[prevSlot]) {
                CrossCoreWaitFlag(PvDoneFlag(prevSlot));
                pvPending[prevSlot] = false;
            }
            GlobalTensor<half> prob, value, partial;
            prob.SetGlobalBuffer(probGm + prevBase * KV_TILE);
            value.SetGlobalBuffer(vGm + (headRowStart + prevStart) * headDim);
            partial.SetGlobalBuffer(partialGm + prevBase * headDim);
            RunPv(mmPV, prob, value, partial, qRows, headDim, prevRows, prev);
            pvPending[prevSlot] = true;
        }
    }
    FlushPvTiles(mmPV, pvPending, probGm, vGm, partialGm, coreIdx, headRowStart,
                 qRows, effectiveKv, headDim, blockRows, innerBlocks);
}

// Wait for outstanding AIV consumers and release the two Matmul objects.
// Inputs: QK/PV Matmul objects and pending slot flags.
// Outputs: completes slot dependencies and both Matmul objects.
template <typename MatmulQK, typename MatmulPV>
__aicore__ inline __attribute__((always_inline)) void FinishAic(
    MatmulQK& mmQK, MatmulPV& mmPV, bool* pvPending)
{
    using namespace AscendC;
    for (int32_t slot = 0; slot < PIPE_SLOTS; ++slot) {
        if (pvPending[slot]) {
            CrossCoreWaitFlag(PvDoneFlag(slot));
        }
    }
    mmQK.End();
    mmPV.End();
}

// Run the Cube-side QK and PV Matmul stages for this core's task range.
// Inputs: pipeline, Q/K/V and intermediate addresses, tilings, and task range.
// Outputs: writes Cube-side score and partial-output intermediates.
__aicore__ inline void RunAicPath(
    AscendC::TPipe* pipe, __gm__ half* q, __gm__ half* k, __gm__ half* v, __gm__ half* scoreGm,
    __gm__ half* probGm,
    __gm__ half* partialGm, __gm__ uint8_t* workspace, int64_t wsSize, __gm__ TCubeTiling* mmTilingQK,
    __gm__ TCubeTiling* mmTilingPV, int32_t coreIdx, int32_t taskBegin, int32_t taskEnd, int64_t seqLen,
    int64_t headDim, int64_t blockRows, int64_t chunksPerHead)
{
    using namespace AscendC;
    // Copy both Matmul tilings locally before registering QK and PV objects.
    TCubeTiling tlQK, tlPV;
    for (size_t i = 0; i < sizeof(TCubeTiling); ++i) {
        reinterpret_cast<uint8_t*>(&tlQK)[i] = reinterpret_cast<__gm__ uint8_t*>(mmTilingQK)[i];
        reinterpret_cast<uint8_t*>(&tlPV)[i] = reinterpret_cast<__gm__ uint8_t*>(mmTilingPV)[i];
    }

    matmul::Matmul<
        matmul::MatmulType<TPosition::GM, CubeFormat::ND, half, false, LayoutMode::NONE>,
        matmul::MatmulType<TPosition::GM, CubeFormat::ND, half, true, LayoutMode::NONE>,
        matmul::MatmulType<TPosition::GM, CubeFormat::ND, half, false, LayoutMode::NONE>,
        matmul::MatmulType<TPosition::GM, CubeFormat::ND, float>, MATMUL_CFG>
        mmQK;
    matmul::Matmul<
        matmul::MatmulType<TPosition::GM, CubeFormat::ND, half, false, LayoutMode::NONE>,
        matmul::MatmulType<TPosition::GM, CubeFormat::ND, half, false, LayoutMode::NONE>,
        matmul::MatmulType<TPosition::GM, CubeFormat::ND, half, false, LayoutMode::NONE>,
        matmul::MatmulType<TPosition::GM, CubeFormat::ND, float>, MATMUL_CFG>
        mmPV;
    REGIST_MATMUL_OBJ(pipe, workspace, mmQK, &tlQK);
    REGIST_MATMUL_OBJ(pipe, workspace + wsSize / 2, mmPV, &tlPV);

    bool pvPending[PIPE_SLOTS] = {false, false};
    if (seqLen <= KV_TILE) {
        RunShortAicTasks(
            mmQK, mmPV, q, k, v, scoreGm, probGm, partialGm, coreIdx,
            taskBegin, taskEnd, seqLen, headDim, blockRows, chunksPerHead);
    } else {
        // Produce QK[n] while consuming Probability[n - 1] in PV.
        for (int32_t taskIdx = taskBegin; taskIdx < taskEnd; ++taskIdx) {
            RunAicTask(mmQK, mmPV, pvPending, q, k, v, scoreGm, probGm,
                       partialGm, coreIdx, taskIdx, seqLen, headDim, blockRows,
                       chunksPerHead);
        }
    }
    FinishAic(mmQK, mmPV, pvPending);
}

// Run causal prefill attention.
// Inputs: BNSD float16 Q/K/V, causal mask, tilings, workspace, and task ranges.
// Output: BNSD float16 attention values written through out.
extern "C" __global__ __aicore__ void fused_infer_attention_kernel(
    __gm__ half* q, __gm__ half* k, __gm__ half* v,
    __gm__ half* mask, __gm__ half* out,
    __gm__ half* scoreGm, __gm__ half* probGm, __gm__ half* partialGm,
    __gm__ uint8_t* workspace, int64_t wsSize,
    __gm__ TCubeTiling* mmTilingQK, __gm__ TCubeTiling* mmTilingPV,
    __gm__ SoftMaxTiling* smTiling, uint32_t smTmpBytes,
    __gm__ int32_t* taskStarts, __gm__ int32_t* taskEnds,
    int64_t seqLen, int64_t headDim, float scale,
    int64_t blockRows, int64_t chunksPerHead)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    using namespace AscendC;

    int32_t coreIdx = GetBlockIdx() / GetTaskRation();
    int32_t taskBegin = taskStarts[coreIdx];
    int32_t taskEnd = taskEnds[coreIdx];
    if (taskBegin >= taskEnd) {
        return;
    }
    TPipe pipe;
    if (g_coreType == AIV) {
        if (seqLen <= KV_TILE) {
            RunShortAivPath(
                &pipe, mask, out, scoreGm, probGm, partialGm, smTiling,
                smTmpBytes, coreIdx, taskBegin, taskEnd, seqLen, headDim,
                scale, blockRows, chunksPerHead);
        } else {
            RunAivPath(
                &pipe, mask, out, scoreGm, probGm, partialGm, smTiling,
                smTmpBytes, coreIdx, taskBegin, taskEnd, seqLen, headDim,
                scale, blockRows, chunksPerHead);
        }
        return;
    }
    if (g_coreType == AIC) {
        RunAicPath(&pipe, q, k, v, scoreGm, probGm, partialGm, workspace, wsSize,
                   mmTilingQK, mmTilingPV, coreIdx, taskBegin, taskEnd,
                   seqLen, headDim, blockRows, chunksPerHead);
    }
}

// ---------------------------------------------------------------------------
// host
// ---------------------------------------------------------------------------
// Build the single-core QK Matmul tiling; return false when tiling fails.
// Inputs: platform and QK M/N/K dimensions.
// Outputs: fills tiling and returns whether generation succeeded.
static bool BuildSingleCoreTiling(platform_ascendc::PlatformAscendC* platform,
                                  int64_t m, int64_t n, int64_t k, TCubeTiling& tiling)
{
    matmul_tiling::MultiCoreMatmulTiling mmTiling(*platform);
    mmTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_FLOAT16, false);
    mmTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_FLOAT16, true);
    mmTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_FLOAT16);
    mmTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                         matmul_tiling::DataType::DT_FLOAT);
    mmTiling.SetDim(1);  // single-core MatMul (each core handles its own Q rows)
    mmTiling.SetOrgShape(m, n, k);
    mmTiling.SetShape(m, n, k);
    mmTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
    mmTiling.EnableBias(false);
    mmTiling.SetBufferSpace(-1, -1, -1);
    mmTiling.SetFixSplit(128, std::min<int64_t>(128, n), 128);
    return mmTiling.GetTiling(tiling) == 0 && tiling.usedCoreNum > 0;
}


// Build the single-core PV Matmul tiling; return false when tiling fails.
// Inputs: platform and PV M/N/K dimensions.
// Outputs: fills tiling and returns whether generation succeeded.
static bool BuildPvTiling(platform_ascendc::PlatformAscendC* platform,
                          int64_t m, int64_t n, int64_t k, TCubeTiling& tiling)
{
    matmul_tiling::MultiCoreMatmulTiling mmTiling(*platform);
    mmTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_FLOAT16, false);
    mmTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_FLOAT16, false);
    mmTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_FLOAT16);
    mmTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                         matmul_tiling::DataType::DT_FLOAT);
    mmTiling.SetDim(1);
    mmTiling.SetOrgShape(m, n, k);
    mmTiling.SetShape(m, n, k);
    mmTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
    mmTiling.EnableBias(false);
    mmTiling.SetBufferSpace(-1, -1, -1);
    mmTiling.SetFixSplit(128, std::min<int64_t>(128, n), 128);
    return mmTiling.GetTiling(tiling) == 0 && tiling.usedCoreNum > 0;
}

// Build first/update SoftmaxFlashV2 tilings and return required temporary bytes.
// Inputs: mutable first-call and update-call tiling objects.
// Outputs: fills both tilings and returns required UB temporary bytes.
static uint32_t BuildOnlineSoftmaxTilings(SoftMaxTiling& firstTiling,
                                           SoftMaxTiling& updateTiling)
{
    ge::Shape shape({SOFTMAX_ROWS, KV_TILE});
    uint32_t firstTmp = AscendC::GetSoftMaxFlashV2MaxTmpSize(
        shape, SOFTMAX_INPUT_TYPE_BYTES, SOFTMAX_STATE_TYPE_BYTES,
        SOFTMAX_FIRST_PASS, SOFTMAX_BASIC_BLOCK);
    uint32_t updateTmp = AscendC::GetSoftMaxFlashV2MaxTmpSize(
        shape, SOFTMAX_INPUT_TYPE_BYTES, SOFTMAX_STATE_TYPE_BYTES,
        SOFTMAX_UPDATE_PASS, SOFTMAX_BASIC_BLOCK);
    uint32_t tmpBytes = std::max(firstTmp, updateTmp);
    AscendC::SoftMaxFlashV2TilingFunc(
        shape, SOFTMAX_INPUT_TYPE_BYTES, SOFTMAX_STATE_TYPE_BYTES, tmpBytes,
        firstTiling, SOFTMAX_FIRST_PASS, SOFTMAX_BASIC_BLOCK);
    AscendC::SoftMaxFlashV2TilingFunc(
        shape, SOFTMAX_INPUT_TYPE_BYTES, SOFTMAX_STATE_TYPE_BYTES, tmpBytes,
        updateTiling, SOFTMAX_UPDATE_PASS, SOFTMAX_BASIC_BLOCK);
    return tmpBytes;
}

// Return value rounded up to a positive alignment.
// Inputs: integer value and positive alignment.
// Returns: the smallest aligned integer not less than value.
static int64_t AlignUp(int64_t value, int64_t alignment)
{
    return CeilDiv(value, alignment) * alignment;
}

// Derive the largest Query block that fits the two AIV sub-cores' UB.
// Inputs: UB capacity, Softmax temp bytes, and head dimension.
// Returns: largest aligned Query block row count that fits UB.
static int64_t GetMaxQueryBlockRows(uint64_t ubSize, uint32_t smTmpBytes,
                                    int64_t headDim)
{
    constexpr uint64_t ONLINE_TILE_QUEUE_COUNT = 3;
    constexpr uint64_t PIPE_RESERVE_BYTES = 4096;
    constexpr uint64_t QUEUE_BYTES =
        ONLINE_TILE_QUEUE_COUNT * SOFTMAX_ROWS * KV_TILE * sizeof(half);
    uint64_t fixedBytes = QUEUE_BYTES + smTmpBytes + PIPE_RESERVE_BYTES;
    uint64_t vectorBytes = 2 * headDim * sizeof(half);
    uint64_t stateBytes =
        2 * SOFTMAX_REDUCE_LANES * sizeof(float) +
        PIPE_SLOTS * NORMALIZE_BROADCAST_LANES * sizeof(half) +
        NORM_BYTES_PER_SUB_ROW;
    if (ubSize <= fixedBytes + vectorBytes + stateBytes) {
        return QUERY_ROW_ALIGN;
    }
    int64_t subRows = (ubSize - fixedBytes) / (vectorBytes + stateBytes);
    int64_t rows = 2 * subRows;
    rows = rows / QUERY_ROW_ALIGN * QUERY_ROW_ALIGN;
    return std::max<int64_t>(QUERY_ROW_ALIGN,
                             std::min<int64_t>(KV_TILE, rows));
}

// Choose a capacity-safe block while creating enough tasks to occupy all AICs.
// Inputs: sequence length, total heads, AIC count, and UB row limit.
// Returns: selected aligned Query block row count.
static int64_t SelectQueryBlockRows(int64_t seqLen, int64_t totalHeads,
                                    uint32_t maxAicCores,
                                    int64_t maxBlockRows)
{
    constexpr int64_t MATMUL_BASE_ROWS = 128;
    // One-KV-tile tasks favor the native Cube block over a wider task.
    if (seqLen <= KV_TILE) {
        return std::min<int64_t>(seqLen, MATMUL_BASE_ROWS);
    }
    int64_t tasksPerHead =
        std::max<int64_t>(1, CeilDiv(maxAicCores, totalHeads));
    int64_t rowsForParallelism = AlignUp(
        CeilDiv(seqLen, tasksPerHead), QUERY_ROW_ALIGN);
    int64_t capacityRows =
        std::min<int64_t>(maxBlockRows, PREFERRED_QUERY_BLOCK_ROWS) /
        QUERY_ROW_ALIGN * QUERY_ROW_ALIGN;
    int64_t minBlockRows = std::min<int64_t>(seqLen, MATMUL_BASE_ROWS);
    return std::max<int64_t>(
        minBlockRows,
        std::min<int64_t>(seqLen,
                          std::min(capacityRows, rowsForParallelism)));
}

// Partition causal tasks into contiguous ranges with similar estimated work.
// Inputs: total heads, sequence/block geometry, and active core count.
// Outputs: fills per-core inclusive starts and exclusive ends.
static void BuildTaskRanges(int64_t totalHeads, int64_t seqLen,
                            int64_t blockRows, uint32_t coreNum,
                            std::vector<int32_t>& starts,
                            std::vector<int32_t>& ends)
{
    int64_t chunksPerHead = CeilDiv(seqLen, blockRows);
    int64_t totalTasks = totalHeads * chunksPerHead;
    std::vector<int64_t> weights(totalTasks, 1);
    int64_t totalWeight = 0;
    for (int64_t task = 0; task < totalTasks; ++task) {
        int64_t chunk = task % chunksPerHead;
        int64_t rowStart = chunk * blockRows;
        int64_t queryRows = std::min<int64_t>(blockRows, seqLen - rowStart);
        int64_t effectiveKv = rowStart + queryRows;
        weights[task] = queryRows * CeilDiv(effectiveKv, KV_TILE);
        totalWeight += weights[task];
    }
    starts.assign(coreNum + 1, 0);
    int64_t task = 0;
    int64_t weight = 0;
    for (uint32_t core = 1; core < coreNum; ++core) {
        int64_t target = totalWeight * core / coreNum;
        while (task < totalTasks &&
               weight + weights[task] <= target) {
            weight += weights[task++];
        }
        starts[core] = static_cast<int32_t>(task);
    }
    starts[coreNum] = static_cast<int32_t>(totalTasks);
    ends.resize(coreNum);
    for (uint32_t core = 0; core < coreNum; ++core) {
        ends[core] = starts[core + 1];
    }
}

struct DemoConfig {
    int64_t batch, seqLen, heads, headDim, warmup, iters;
    int64_t kernelSeq, totalRows, totalHeads, blockRows, chunksPerHead;
    uint32_t cores, smTmpBytes;
    float scale;
    size_t qBytes, maskBytes, scoreBytes, partialBytes;
    SoftMaxTiling smTilings[2];
    TCubeTiling qkTiling, pvTiling;
    std::vector<int32_t> taskStarts, taskEnds;
};

struct HostData {
    std::vector<uint16_t> query, key, value, mask;
};

struct DeviceData {
    void* query = nullptr;
    void* key = nullptr;
    void* value = nullptr;
    void* mask = nullptr;
    void* output = nullptr;
    void* score = nullptr;
    void* prob = nullptr;
    void* partial = nullptr;
    void* workspace = nullptr;
    void* qkTiling = nullptr;
    void* pvTiling = nullptr;
    void* smTiling = nullptr;
    void* taskStarts = nullptr;
    void* taskEnds = nullptr;
    aclrtStream stream = nullptr;
    bool runtimeInitialized = false;
    bool deviceSelected = false;
};

// Parse the demo arguments and derive all tiling and workspace dimensions.
// Inputs: process argc/argv and mutable demo configuration.
// Outputs: fills cfg and returns false for unsupported input or failed tiling.
static bool BuildDemoConfig(int32_t argc, char** argv, DemoConfig& cfg)
{
    cfg.batch = ParseArg(argc, argv, "--batch", 2);
    cfg.seqLen = ParseArg(argc, argv, "--seq", 64);
    cfg.heads = ParseArg(argc, argv, "--heads", 8);
    cfg.headDim = ParseArg(argc, argv, "--head_dim", 64);
    cfg.warmup = ParseArg(argc, argv, "--warmup", 5);
    cfg.iters = ParseArg(argc, argv, "--iters", 20);
    if (cfg.batch <= 0 || cfg.heads <= 0 || cfg.seqLen <= 0 ||
        (cfg.headDim != 64 && cfg.headDim != 128)) {
        std::printf("[ERROR] require positive B/H/S and D=64 or 128\n");
        return false;
    }
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        std::printf("[ERROR] failed to get Ascend C platform\n");
        return false;
    }
    uint32_t maxCores = std::max<uint32_t>(1, platform->GetCoreNumAic());
    cfg.kernelSeq = AlignUp(cfg.seqLen, 64);
    cfg.totalHeads = cfg.batch * cfg.heads;
    cfg.totalRows = cfg.totalHeads * cfg.kernelSeq;
    cfg.scale = static_cast<float>(1.0 / std::sqrt(cfg.headDim));
    cfg.smTmpBytes = BuildOnlineSoftmaxTilings(
        cfg.smTilings[0], cfg.smTilings[1]);
    uint64_t ubSize = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t maxRows = GetMaxQueryBlockRows(ubSize, cfg.smTmpBytes, cfg.headDim);
    cfg.blockRows = SelectQueryBlockRows(
        cfg.kernelSeq, cfg.totalHeads, maxCores, maxRows);
    cfg.chunksPerHead = CeilDiv(cfg.kernelSeq, cfg.blockRows);
    cfg.cores = static_cast<uint32_t>(std::min<int64_t>(
        maxCores, cfg.totalHeads * cfg.chunksPerHead));
    BuildTaskRanges(cfg.totalHeads, cfg.kernelSeq, cfg.blockRows, cfg.cores,
                    cfg.taskStarts, cfg.taskEnds);
    int64_t tilingRows = std::max<int64_t>(cfg.blockRows, 128);
    bool ok = BuildSingleCoreTiling(
        platform, tilingRows, KV_TILE, cfg.headDim, cfg.qkTiling);
    ok = ok && BuildPvTiling(
        platform, tilingRows, cfg.headDim, KV_TILE, cfg.pvTiling);
    cfg.qBytes = cfg.totalRows * cfg.headDim * sizeof(half);
    cfg.maskBytes = cfg.kernelSeq * cfg.kernelSeq * sizeof(half);
    cfg.scoreBytes = cfg.cores * PIPE_SLOTS * cfg.blockRows * KV_TILE * sizeof(half);
    cfg.partialBytes = cfg.cores * PIPE_SLOTS * cfg.blockRows * cfg.headDim * sizeof(half);
    return ok;
}

// Build deterministic Q/K/V data and a causal mask for correctness checking.
// Inputs: validated demo configuration.
// Returns: populated host Q/K/V tensors and causal mask.
static HostData BuildHostData(const DemoConfig& cfg)
{
    HostData data{
        std::vector<uint16_t>(cfg.totalRows * cfg.headDim),
        std::vector<uint16_t>(cfg.totalRows * cfg.headDim),
        std::vector<uint16_t>(cfg.totalRows * cfg.headDim),
        std::vector<uint16_t>(cfg.kernelSeq * cfg.kernelSeq)};
    for (int64_t head = 0; head < cfg.totalHeads; ++head) {
        for (int64_t row = 0; row < cfg.seqLen; ++row) {
            for (int64_t d = 0; d < cfg.headDim; ++d) {
                int64_t offset = (head * cfg.kernelSeq + row) * cfg.headDim + d;
                int64_t logical = (head * cfg.seqLen + row) * cfg.headDim + d;
                half value = static_cast<half>(
                    static_cast<float>(logical % 1000 - 500) / 1000.0f);
                data.query[offset] = HalfToBits(value);
                data.key[offset] = data.query[offset];
                data.value[offset] = data.query[offset];
            }
        }
    }
    for (int64_t row = 0; row < cfg.kernelSeq; ++row) {
        for (int64_t col = 0; col < cfg.kernelSeq; ++col) {
            data.mask[row * cfg.kernelSeq + col] =
                col > row ? static_cast<uint16_t>(0xFC00) : 0;
        }
    }
    return data;
}

// Allocate every buffer used by the kernel. Existing allocations remain in
// dev so ReleaseDevice can unwind them if a later allocation fails.
// Inputs: demo configuration and mutable device resources.
// Outputs: records allocations in dev and returns false on allocation failure.
static bool AllocateDeviceBuffers(const DemoConfig& cfg, DeviceData& dev)
{
    constexpr size_t WORKSPACE_BYTES = 16 * 1024 * 1024;
    bool ok = CheckAcl(
        aclrtMalloc(&dev.query, cfg.qBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mq");
    ok = ok && CheckAcl(
        aclrtMalloc(&dev.key, cfg.qBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mk");
    ok = ok && CheckAcl(
        aclrtMalloc(&dev.value, cfg.qBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mv");
    ok = ok && CheckAcl(
        aclrtMalloc(&dev.mask, cfg.maskBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mm");
    ok = ok && CheckAcl(
        aclrtMalloc(&dev.output, cfg.qBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mo");
    ok = ok && CheckAcl(
        aclrtMalloc(&dev.score, cfg.scoreBytes, ACL_MEM_MALLOC_HUGE_FIRST), "ms");
    ok = ok && CheckAcl(
        aclrtMalloc(&dev.prob, cfg.scoreBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mp");
    ok = ok && CheckAcl(
        aclrtMalloc(&dev.partial, cfg.partialBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mr");
    ok = ok && CheckAcl(
        aclrtMalloc(&dev.workspace, WORKSPACE_BYTES, ACL_MEM_MALLOC_HUGE_FIRST), "mws");
    ok = ok && CheckAcl(aclrtMalloc(
        &dev.qkTiling, sizeof(TCubeTiling), ACL_MEM_MALLOC_HUGE_FIRST), "mtqk");
    ok = ok && CheckAcl(aclrtMalloc(
        &dev.pvTiling, sizeof(TCubeTiling), ACL_MEM_MALLOC_HUGE_FIRST), "mtpv");
    ok = ok && CheckAcl(aclrtMalloc(
        &dev.smTiling, sizeof(cfg.smTilings), ACL_MEM_MALLOC_HUGE_FIRST), "msm");
    size_t taskBytes = sizeof(int32_t) * cfg.cores;
    ok = ok && CheckAcl(aclrtMalloc(
        &dev.taskStarts, taskBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mstarts");
    return ok && CheckAcl(aclrtMalloc(
        &dev.taskEnds, taskBytes, ACL_MEM_MALLOC_HUGE_FIRST), "mends");
}

// Copy Q/K/V, mask, tilings, and task ranges to their allocated buffers.
// Inputs: demo configuration, host tensors, and allocated device resources.
// Outputs: populates device buffers and returns false on copy failure.
static bool CopyDeviceInputs(
    const DemoConfig& cfg, const HostData& host, DeviceData& dev)
{
    size_t taskBytes = sizeof(int32_t) * cfg.cores;
    bool ok = CheckAcl(aclrtMemcpy(
        dev.query, cfg.qBytes, host.query.data(), cfg.qBytes,
        ACL_MEMCPY_HOST_TO_DEVICE), "cq");
    ok = ok && CheckAcl(aclrtMemcpy(
        dev.key, cfg.qBytes, host.key.data(), cfg.qBytes,
        ACL_MEMCPY_HOST_TO_DEVICE), "ck");
    ok = ok && CheckAcl(aclrtMemcpy(
        dev.value, cfg.qBytes, host.value.data(), cfg.qBytes,
        ACL_MEMCPY_HOST_TO_DEVICE), "cv");
    ok = ok && CheckAcl(aclrtMemcpy(
        dev.mask, cfg.maskBytes, host.mask.data(), cfg.maskBytes,
        ACL_MEMCPY_HOST_TO_DEVICE), "cm");
    ok = ok && CheckAcl(aclrtMemcpy(
        dev.qkTiling, sizeof(TCubeTiling), &cfg.qkTiling,
        sizeof(TCubeTiling), ACL_MEMCPY_HOST_TO_DEVICE), "ctqk");
    ok = ok && CheckAcl(aclrtMemcpy(
        dev.pvTiling, sizeof(TCubeTiling), &cfg.pvTiling,
        sizeof(TCubeTiling), ACL_MEMCPY_HOST_TO_DEVICE), "ctpv");
    ok = ok && CheckAcl(aclrtMemcpy(
        dev.smTiling, sizeof(cfg.smTilings), cfg.smTilings,
        sizeof(cfg.smTilings), ACL_MEMCPY_HOST_TO_DEVICE), "csm");
    ok = ok && CheckAcl(aclrtMemcpy(
        dev.taskStarts, taskBytes, cfg.taskStarts.data(),
        taskBytes, ACL_MEMCPY_HOST_TO_DEVICE), "cstarts");
    return ok && CheckAcl(aclrtMemcpy(
        dev.taskEnds, taskBytes, cfg.taskEnds.data(),
        taskBytes, ACL_MEMCPY_HOST_TO_DEVICE), "cends");
}

// Initialize ACL, allocate buffers, and copy all host-side inputs.
// Inputs: demo configuration, host tensors, and mutable device resources.
// Outputs: prepares dev and returns false when any initialization step fails.
static bool PrepareDevice(
    const DemoConfig& cfg, const HostData& host, DeviceData& dev)
{
    if (!CheckAcl(aclInit(nullptr), "init")) {
        return false;
    }
    dev.runtimeInitialized = true;
    if (!CheckAcl(aclrtSetDevice(0), "dev")) {
        return false;
    }
    dev.deviceSelected = true;
    if (!CheckAcl(aclrtCreateStream(&dev.stream), "stream")) {
        return false;
    }
    return AllocateDeviceBuffers(cfg, dev) && CopyDeviceInputs(cfg, host, dev);
}

// Submit warmup and measurement kernels; return false when synchronization fails.
// Inputs: demo configuration and prepared device resources.
// Outputs: enqueues launches and returns the final stream status.
static bool RunDemoKernel(const DemoConfig& cfg, DeviceData& dev)
{
    constexpr int64_t WORKSPACE_BYTES = 16 * 1024 * 1024;
    for (int64_t i = 0; i < cfg.warmup + cfg.iters; ++i) {
        fused_infer_attention_kernel<<<cfg.cores, nullptr, dev.stream>>>(
            static_cast<half*>(dev.query), static_cast<half*>(dev.key),
            static_cast<half*>(dev.value), static_cast<half*>(dev.mask),
            static_cast<half*>(dev.output), static_cast<half*>(dev.score),
            static_cast<half*>(dev.prob), static_cast<half*>(dev.partial),
            static_cast<uint8_t*>(dev.workspace), WORKSPACE_BYTES,
            static_cast<TCubeTiling*>(dev.qkTiling),
            static_cast<TCubeTiling*>(dev.pvTiling),
            static_cast<SoftMaxTiling*>(dev.smTiling), cfg.smTmpBytes,
            static_cast<int32_t*>(dev.taskStarts),
            static_cast<int32_t*>(dev.taskEnds), cfg.kernelSeq, cfg.headDim,
            cfg.scale, cfg.blockRows, cfg.chunksPerHead);
    }
    return CheckAcl(aclrtSynchronizeStream(dev.stream), "sync");
}

// Compute the reference error for one Query row.
// Inputs: configuration, host tensors, device output copy, head, and row.
// Returns: maximum absolute error for the selected Query row.
static float CheckReferenceRow(
    const DemoConfig& cfg, const HostData& host,
    const std::vector<uint16_t>& output, int64_t head, int64_t row)
{
    int64_t headStart = head * cfg.kernelSeq;
    int64_t queryRow = headStart + row;
    std::vector<float> scores(cfg.seqLen);
    float rowMax = -1e30f;
    for (int64_t col = 0; col < cfg.seqLen; ++col) {
        float dot = 0.0f;
        for (int64_t d = 0; d < cfg.headDim; ++d) {
            dot += static_cast<float>(BitsToHalf(host.query[queryRow * cfg.headDim + d])) *
                   static_cast<float>(BitsToHalf(host.key[(headStart + col) * cfg.headDim + d]));
        }
        scores[col] = dot * cfg.scale + (col > row ? -1e12f : 0.0f);
        rowMax = std::max(rowMax, scores[col]);
    }
    float sum = 0.0f;
    for (float score : scores) {
        sum += std::exp(score - rowMax);
    }
    float maxError = 0.0f;
    for (int64_t d = 0; d < cfg.headDim; ++d) {
        float reference = 0.0f;
        for (int64_t col = 0; col < cfg.seqLen; ++col) {
            float value = static_cast<float>(
                BitsToHalf(host.value[(headStart + col) * cfg.headDim + d]));
            reference += std::exp(scores[col] - rowMax) / sum * value;
        }
        float actual = static_cast<float>(
            BitsToHalf(output[queryRow * cfg.headDim + d]));
        maxError = std::max(maxError, std::fabs(actual - reference));
    }
    return maxError;
}

// Copy the output and compare every unpadded row with the host reference.
// Inputs: configuration, host tensors, and completed device resources.
// Returns: true when the output copy succeeds and all values pass.
static bool CheckDemoResult(
    const DemoConfig& cfg, const HostData& host, const DeviceData& dev)
{
    std::vector<uint16_t> output(cfg.totalRows * cfg.headDim);
    if (!CheckAcl(aclrtMemcpy(
        output.data(), cfg.qBytes, dev.output, cfg.qBytes,
        ACL_MEMCPY_DEVICE_TO_HOST), "co")) {
        return false;
    }
    float maxError = 0.0f;
    for (int64_t head = 0; head < cfg.totalHeads; ++head) {
        for (int64_t row = 0; row < cfg.seqLen; ++row) {
            maxError = std::max(
                maxError, CheckReferenceRow(cfg, host, output, head, row));
        }
    }
    std::printf("%s max_err=%f\n", maxError <= 0.01f ? "PASS" : "FAIL", maxError);
    return maxError <= 0.01f;
}

// Free one optional device allocation and clear its handle.
// Inputs: mutable device pointer.
// Outputs: frees non-null storage and sets the pointer to nullptr.
static void FreeDeviceBuffer(void*& buffer)
{
    if (buffer != nullptr) {
        aclrtFree(buffer);
        buffer = nullptr;
    }
}

// Release every ACL resource successfully acquired by the demo.
// Inputs: mutable device resource holder.
// Outputs: frees buffers, destroys the stream, resets the device, and finalizes ACL.
static void ReleaseDevice(DeviceData& dev)
{
    FreeDeviceBuffer(dev.query);
    FreeDeviceBuffer(dev.key);
    FreeDeviceBuffer(dev.value);
    FreeDeviceBuffer(dev.mask);
    FreeDeviceBuffer(dev.output);
    FreeDeviceBuffer(dev.score);
    FreeDeviceBuffer(dev.prob);
    FreeDeviceBuffer(dev.partial);
    FreeDeviceBuffer(dev.workspace);
    FreeDeviceBuffer(dev.qkTiling);
    FreeDeviceBuffer(dev.pvTiling);
    FreeDeviceBuffer(dev.smTiling);
    FreeDeviceBuffer(dev.taskStarts);
    FreeDeviceBuffer(dev.taskEnds);
    if (dev.stream != nullptr) {
        aclrtDestroyStream(dev.stream);
        dev.stream = nullptr;
    }
    if (dev.deviceSelected) {
        aclrtResetDevice(0);
        dev.deviceSelected = false;
    }
    if (dev.runtimeInitialized) {
        aclFinalize();
        dev.runtimeInitialized = false;
    }
}

// Configure, run, optionally check, and clean up the Ascend C demo.
// Inputs: process argc/argv.
// Returns: zero on success and nonzero on setup, runtime, or correctness failure.
int32_t main(int32_t argc, char** argv)
{
    DemoConfig cfg{};
    if (!BuildDemoConfig(argc, argv, cfg)) {
        return 1;
    }
    std::printf("[CONFIG] totalRows=%ld blockRows=%ld chunks=%ld cores=%u\n",
                cfg.totalRows, cfg.blockRows, cfg.chunksPerHead, cfg.cores);
    HostData host = BuildHostData(cfg);
    DeviceData dev;
    if (!PrepareDevice(cfg, host, dev)) {
        ReleaseDevice(dev);
        return 1;
    }
    bool passed = RunDemoKernel(cfg, dev);
    passed = passed &&
             (!NeedCheck(argc, argv) || CheckDemoResult(cfg, host, dev));
    ReleaseDevice(dev);
    if (!passed) {
        return 1;
    }
    std::printf(
        "DONE op=fused_infer_attention backend=ascendc "
        "shape=(%ld,%ld,%ld,%ld) warmup=%ld iters=%ld cores=%u\n",
        cfg.batch, cfg.heads, cfg.seqLen, cfg.headDim,
        cfg.warmup, cfg.iters, cfg.cores);
    return 0;
}
