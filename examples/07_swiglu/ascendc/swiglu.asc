#include "acl/acl.h"
#include "basic_api/kernel_operator.h"
#include "tiling/platform/platform_ascendc.h"

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

static int64_t CeilDiv(int64_t a, int64_t b) { return (a + b - 1) / b; }

static int64_t ParseArg(int argc, char** argv, const char* name, int64_t defaultValue)
{
    for (int i = 1; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], name) == 0) {
            return std::atoll(argv[i + 1]);
        }
    }
    return defaultValue;
}

static float ParseFloatArg(int argc, char** argv, const char* name, float defaultValue)
{
    for (int i = 1; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], name) == 0) {
            return std::atof(argv[i + 1]);
        }
    }
    return defaultValue;
}

static bool NeedCheck(int argc, char** argv)
{
    for (int i = 1; i < argc; ++i) {
        if (std::strcmp(argv[i], "--check") == 0) {
            return true;
        }
    }
    return false;
}

static int64_t PickCoreCount(int64_t neededCores, int64_t maxCoreNum)
{
    int64_t candidate = 1;
    int64_t best = 1;
    while (candidate <= maxCoreNum) {
        best = candidate;
        if (neededCores <= candidate) {
            return candidate;
        }
        candidate *= 2;
    }
    return maxCoreNum;
}

static int64_t GetAivCoreNum()
{
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return 8;
    }
    uint32_t coreNum = platform->GetCoreNumAiv();
    return coreNum == 0 ? 8 : static_cast<int64_t>(coreNum);
}

static void CheckAcl(aclError ret, const char* what)
{
    if (ret != ACL_SUCCESS) {
        std::printf("[ERROR] %s failed, ret=%d\n", what, static_cast<int>(ret));
        std::exit(1);
    }
}


extern "C" __global__ __vector__ void swi_glu_kernel(
    GM_ADDR fused, GM_ADDR y,
    int64_t blockFactor, int64_t totalTiles,
    int64_t tileFactor, int64_t halfLen)
{
    int64_t coreIdx = AscendC::GetBlockIdx();
    int64_t blockOffset = coreIdx * blockFactor;
    constexpr int64_t BUFFER_NUM = 2;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueGate;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueUp;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQue;

    AscendC::GlobalTensor<float> fusedGm, yGm;
    fusedGm.SetGlobalBuffer((__gm__ float*)fused + blockOffset, blockFactor);
    yGm.SetGlobalBuffer((__gm__ float*)y + blockOffset, blockFactor);

    int64_t tileBytes = tileFactor * sizeof(float);
    pipe.InitBuffer(inQueGate, BUFFER_NUM, tileBytes);
    pipe.InitBuffer(inQueUp, BUFFER_NUM, tileBytes);
    pipe.InitBuffer(outQue, BUFFER_NUM, tileBytes);

    for (int64_t i = 0; i < totalTiles; i++) {
        int64_t gmOffset = i * tileFactor;
        AscendC::LocalTensor<float> gateLocal = inQueGate.AllocTensor<float>();
        AscendC::LocalTensor<float> upLocal = inQueUp.AllocTensor<float>();
        AscendC::DataCopy(gateLocal, fusedGm[gmOffset], tileFactor);
        AscendC::DataCopy(upLocal, fusedGm[halfLen + gmOffset], tileFactor);
        inQueGate.EnQue(gateLocal);
        inQueUp.EnQue(upLocal);

        gateLocal = inQueGate.DeQue<float>();
        upLocal = inQueUp.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = outQue.AllocTensor<float>();

        AscendC::SwiGLU<float>(yLocal, upLocal, gateLocal, 1.0f, static_cast<uint32_t>(tileFactor));

        inQueGate.FreeTensor(gateLocal);
        inQueUp.FreeTensor(upLocal);
        outQue.EnQue(yLocal);
        yLocal = outQue.DeQue<float>();
        AscendC::DataCopy(yGm[gmOffset], yLocal, tileFactor);
        outQue.FreeTensor(yLocal);
    }
}

int32_t main(int32_t argc, char** argv)
{
    int64_t batch = ParseArg(argc, argv, "--batch", 2);
    int64_t seq = ParseArg(argc, argv, "--seq", 64);
    int64_t hidden = ParseArg(argc, argv, "--hidden", 256);
    int64_t warmup = ParseArg(argc, argv, "--warmup", 5);
    int64_t iters = ParseArg(argc, argv, "--iters", 20);
    int64_t totalElements = batch * seq * hidden;
    int64_t useCoreNum = GetAivCoreNum();
    constexpr int64_t dtypeSize = sizeof(float);
    constexpr int64_t preferredCopyBytes = 2048;
    constexpr int64_t fallbackCopyBytes = 1024;
    int64_t tileFactor = totalElements >= preferredCopyBytes / dtypeSize
        ? preferredCopyBytes / dtypeSize : fallbackCopyBytes / dtypeSize;
    int64_t neededCores = std::min(CeilDiv(totalElements, tileFactor), useCoreNum);
    int64_t usedCoreNum = PickCoreCount(neededCores, useCoreNum);
    int64_t blockLengthRaw = CeilDiv(totalElements, usedCoreNum);
    int64_t totalTiles = CeilDiv(blockLengthRaw, tileFactor);
    int64_t blockFactor = totalTiles * tileFactor;
    int64_t paddedElements = usedCoreNum * blockFactor;
    size_t bytes = paddedElements * sizeof(float);

    CheckAcl(aclInit(nullptr), "aclInit");
    CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");
    aclrtStream stream = nullptr;
    CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

    std::vector<float> fusedHost(paddedElements * 2, 0.0f), yHost(paddedElements, 0.0f);
    for (int64_t i = 0; i < totalElements; ++i) {
        fusedHost[i] = static_cast<float>((i % 257) - 128) / 64.0f;
        fusedHost[paddedElements + i] = static_cast<float>((i % 131) - 65) / 32.0f;
    }

    void *fusedDev = nullptr, *yDev = nullptr;
    CheckAcl(aclrtMalloc(&fusedDev, bytes * 2, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc fused");
    CheckAcl(aclrtMalloc(&yDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc y");
    CheckAcl(aclrtMemcpy(fusedDev, bytes * 2, fusedHost.data(), bytes * 2, ACL_MEMCPY_HOST_TO_DEVICE), "copy fused");

    for (int64_t i = 0; i < warmup + iters; ++i) {
        swi_glu_kernel<<<usedCoreNum, nullptr, stream>>>(
            static_cast<uint8_t*>(fusedDev), static_cast<uint8_t*>(yDev),
            blockFactor, totalTiles, tileFactor, paddedElements);
    }
    CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");

    if (NeedCheck(argc, argv)) {
        CheckAcl(aclrtMemcpy(yHost.data(), bytes, yDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy y");
        float maxErr = 0.0f;
        for (int64_t i = 0; i < totalElements; ++i) {
            float ref = fusedHost[i] / (1.0f + std::exp(-fusedHost[i])) * fusedHost[paddedElements + i];
            maxErr = std::max(maxErr, std::fabs(yHost[i] - ref));
        }
        if (maxErr > 1e-3f) {
            std::printf("FAIL max_err=%f\n", maxErr);
            return 1;
        }
    }

    aclrtFree(fusedDev);
    aclrtFree(yDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    std::printf("DONE op=swiglu backend=ascendc shape=(%ld,%ld,%ld) warmup=%ld iters=%ld\n",
                batch, seq, hidden, warmup, iters);
    return 0;
}
